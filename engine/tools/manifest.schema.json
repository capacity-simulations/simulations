{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Engine sim manifest",
  "type": "object",
  "required": ["manifestVersion", "sim", "engine", "modules"],
  "additionalProperties": false,
  "properties": {
    "manifestVersion": { "const": 1 },
    "sim": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$",
      "description": "Sim id as <course>/<slug>, e.g. qm/double-slit-measurement"
    },
    "engine": {
      "type": "string",
      "description": "Engine version pin, e.g. 1.0.0"
    },
    "modules": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z]+\\.[a-z0-9-]+$|^shell$" },
      "minItems": 1,
      "uniqueItems": true,
      "description": "Closed set of engine modules. Must include verify.audit."
    },
    "vendor": {
      "type": "array",
      "items": { "enum": ["three", "katex", "fonts"] },
      "uniqueItems": true
    },
    "params": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "min", "max", "step", "default"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "min": { "type": "number" },
          "max": { "type": "number" },
          "step": { "type": "number" },
          "default": { "type": "number" },
          "unit": { "type": "string" },
          "fmt": { "type": "string" }
        }
      }
    },
    "build": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "required": ["engineVersion", "date", "hash"],
          "additionalProperties": false,
          "properties": {
            "engineVersion": { "type": "string" },
            "date": { "type": "string" },
            "hash": { "type": "string", "pattern": "^[0-9a-f]{12}$" }
          }
        }
      ]
    }
  }
}
