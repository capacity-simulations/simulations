    .explore-btn { position: relative; }
    .explore-btn input { position: absolute; opacity: 0; pointer-events: none; }
    .explore-btn input:focus-visible ~ .explore-btn-text { outline: 2px solid #3b9b8f; outline-offset: 4px; border-radius: 4px; }
